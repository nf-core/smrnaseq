//This profile handles QIASEQ miRNA defaults. Include it as an additional profile to set certain pipeline parameters appropriately.
params{
    clip_r1 = 0
    three_prime_clip_r1 = 0
    three_prime_adapter = "AACTGTAGGCACCATCAAT"
    // QIAseq miRNA read structure: <insert><AACTGTAGGCACCATCAAT><12 nt UMI><Illumina adapter>.
    // Only used with --with_umi: umi_tools extract finds the UMI after the kit adapter (up to 2 mismatches)
    // and removes the adapter, the UMI and everything after it, leaving the insert.
    umitools_extract_method = 'regex'
    umitools_bc_pattern = '.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'
}
