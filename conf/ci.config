// CI max resource settings
process {
    withLabel:'.*' {
        cpus   = 2
        memory = 6.GB
        time   = 6.h
    }
    withLabel:process_single {
        cpus   = 2
        memory = 6.GB
        time   = 6.h
    }
    // fastp writes --thread into JSON reports, so keep CI snapshots independent
    // of runner CPU limits and profile-specific resource caps.
    withName: '.*:FASTQ_FASTQC_UMITOOLS_FASTP:FASTP' {
        cpus = 1
    }
    withName: '.*:FASTP3' {
        cpus = 1
    }
    withName: 'FASTP_LENGTH_FILTER' {
        cpus = 1
    }
}
