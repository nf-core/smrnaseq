/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Output files are published with workflow outputs (see the `output` block in main.nf).
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/



process {

    //
    // FASTQ_FASTQC_UMITOOLS_FASTP
    //
    withName: '.*:FASTQ_FASTQC_UMITOOLS_FASTP:FASTP' {
        // With --with_umi, fastp runs after umi_tools extract. A regex pattern removes everything after
        // the UMI (kit anchor and 3' adapter), so fastp does not trim adapters from the inserts then.
        ext.args = [ "",
            params.trim_fastq && !(params.with_umi && params.umitools_extract_method == 'regex') ? "" : "--disable_adapter_trimming",
            params.clip_r1 > 0                          ? "--trim_front1 ${params.clip_r1}" : "", // Remove bp from the 5' end of read 1.
            params.fastp_min_length > 0                 ? "-l ${params.fastp_min_length}" : "",
            params.fastp_max_length > 0                 ? "--max_len1 ${params.fastp_max_length}" : "",
            params.three_prime_adapter == "auto-detect" || (params.with_umi && params.umitools_extract_method == 'regex') ? "" : "--adapter_sequence ${params.three_prime_adapter}"
        ].join(" ").trim()
    }
    //
    // FASTQ_FASTQC_UMITOOLS_FASTP
    //
    withName: '.*:FASTP3' {
        ext.prefix =  { "${meta.id}.fastp3" }
        ext.args = [ "",
            "--disable_adapter_trimming",
            "--disable_quality_filtering",
            params.three_prime_clip_r1 > 0              ? "--trim_tail1 ${params.three_prime_clip_r1}" : "", // Remove bp from the 3' end of read 1 AFTER adapter/quality trimming has been performed.
            params.fastp_min_length > 0                 ? "-l ${params.fastp_min_length}" : "",
            params.fastp_max_length > 0                 ? "--max_len1 ${params.fastp_max_length}" : "",
        ].join(" ").trim()
    }
    withName: '.*:FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_RAW' {
        //the prefix is required for multiqc to pickup the files separately from the other fastqc instances
        ext.prefix =  { "${meta.id}.raw" }
        ext.args = '--quiet'
    }
    withName: '.*:FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_TRIM' {
        ext.prefix =  { "${meta.id}.trim" }
        ext.args = '--quiet'
    }

    //
    // Make bowtie index
    //

    withName: 'CLEAN_FASTA' {
        ext.args = "-c fastx '{gsub(/[^ATGCatgc]/, \"N\", \$seq); sub(/ .*/, \"\", \$name); print \">\"\$name\"\\n\"\$seq}'"
        ext.prefix = {"_clean"}
    }

    //
    // UMI deduplication
    //

    // UMICollapse in FastQ mode on UMI + insert (UMI_TO_SEQUENCE moves the UMI into the sequence first).
    // Override ext.args with '--algo dir -k 0' for exact UMI matching (see docs/usage.md).
    withName: '.*:UMICOLLAPSE_FASTQ' {
        ext.args = { "--algo ${params.umitools_method}" }
        ext.prefix = { "${meta.id}.umi_dedup.sorted" }
    }

    // Experimental alignment-based deduplication with fgumi (--umi_dedup_method fgumi), see docs/usage.md
    withName: '.*UMI_DEDUP_REFERENCE:UMI_DEDUP_WINDOWS' {
        // Flanking nucleotides taken from the hairpin on each side of the mature sequence
        ext.args = '-v flank=5'
    }
    withName: '.*UMI_DEDUP_FGUMI:BOWTIE_MAP_UMI_DEDUP' {
        // fgumi needs exactly one record per read: Bowtie 1 with -k > 1 writes every hit as a primary record
        ext.args = [ "",
            "-t",
            "-k 1",
            "--best",
            "-e 99999",
            "--chunkmbs 2048",
            params.mirna_forward_only ? "--norc" : "",
        ].join(" ").trim()
        ext.prefix = { "${meta.id}.umi_dedup_windows" }
    }
    withName: '.*UMI_DEDUP_FGUMI:FGUMI_COPYUMI' {
        // umi_tools extract appends the UMI to the read name as <name>_<UMI>
        ext.args = '--field-delimiter _'
    }
    withName: '.*UMI_DEDUP_FGUMI:FGUMI_SORT' {
        ext.args = '--order template-coordinate'
    }
    withName: '.*UMI_DEDUP_FGUMI:FGUMI_DEDUP' {
        // identity: only reads with identical UMIs at the same position are duplicates (no UMI error correction).
        // --include-unmapped: reads that do not align to the deduplication reference are passed through.
        ext.args   = '--strategy identity --remove-duplicates --include-unmapped'
        ext.prefix = { "${meta.id}.umi_dedup" }
    }
    withName: '.*UMI_DEDUP_FGUMI:FGUMI_FASTQ' {
        ext.prefix = { "${meta.id}.umi_dedup" }
    }

    withName: 'UMITOOLS_EXTRACT' {
        ext.args  = [
            params.umitools_extract_method ? "--extract-method=${params.umitools_extract_method}" : '',
            params.umitools_bc_pattern     ? "--bc-pattern='${params.umitools_bc_pattern}'" : '',
        ].join(' ').trim()
    }

    //
    // CONTAMINANT_FILTER
    //

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:BLAT.*' {
        ext.args = '-out=blast8'
        ext.prefix = {"${meta.id}_${meta2.id}"}
        tag = {"${meta.id} ${meta2.id}"}
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:GAWK.*' {
        ext.prefix = {"significant_hits_${meta.id}"}
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:SEQKIT_GREP.*' {
        ext.prefix = {"filtered_${meta.id}"}
        ext.args = '-v'
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:BOWTIE2_ALIGN.*' {
        ext.args = '--very-sensitive-local -k 1'
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:STATS_GAWK_RRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "rRNA" + '\\": " tot}\''
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:STATS_GAWK_TRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "tRNA" + '\\": " tot}\''
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:STATS_GAWK_CDNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "cDNA" + '\\": " tot}\''
    }
        withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:STATS_GAWK_NCRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "ncRNA" + '\\": " tot}\''
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:STATS_GAWK_PIRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "piRNA" + '\\": " tot}\''
    }

    withName: 'NFCORE_SMRNASEQ:CONTAMINANT_FILTER:STATS_GAWK_OTHER' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "other" + '\\": " tot}\''
    }

    //
    // MIRNA_QUANT
    //
    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BOWTIE_MAP_MATURE' {
        ext.args = [ "",
            "-t",
            "-k 50",
            "--best",
            "--strata",
            "-e 99999",
            "--chunkmbs 2048",
            params.mirna_forward_only ? "--norc" : "",
        ].join(" ").trim()
    }
    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BAM_STATS_MATURE:.*' {
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BOWTIE_MAP_HAIRPIN' {
        ext.args = [ "",
            "-t",
            "-k 50",
            "--best",
            "--strata",
            "-e 99999",
            "--chunkmbs 2048",
            params.mirna_forward_only ? "--norc" : "",
        ].join(" ").trim()
    }
    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BAM_STATS_HAIRPIN:.*' {
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: 'SEQCLUSTER_COLLAPSE' {
        ext.args    = "-m 1 --min_size 15"
        ext.prefix  = {"${meta.id}_seqcluster"}
    }
    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BOWTIE_MAP_SEQCLUSTER' {
        ext.args = [ "",
            "-t",
            "-k 50",
            "--best",
            "--strata",
            "-e 99999",
            "--chunkmbs 2048",
            params.mirna_forward_only ? "--norc" : "",
        ].join(" ").trim()
    }

    // Mirtop

    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BAM_STATS_MIRNA_MIRTOP:MIRTOP_COUNTS' {
        ext.args   = '--add-extra'
    }

    withName: 'NFCORE_SMRNASEQ:MIRNA_QUANT:BAM_STATS_MIRNA_MIRTOP:MIRTOP_GFF' {
        ext.args   = params.mirgenedb ? "--database MirGeneDB" : ''
        // TODO: move to the `output` block in main.nf once the nf-core BAM_STATS_MIRNA_MIRTOP
        // subworkflow emits MIRTOP_GFF.out.gff. Until then this is the only publishDir left.
        publishDir = [
            path: { "${params.outdir}/mirna_quant/mirtop/gff" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //
    // GENOME_QUANT
    //
    withName: 'NFCORE_SMRNASEQ:GENOME_QUANT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_.*' {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'SAMTOOLS_INDEX' {
        ext.args = '-c'
    }

    withName: 'NFCORE_SMRNASEQ:GENOME_QUANT:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: 'NFCORE_SMRNASEQ:GENOME_QUANT:BOWTIE_MAP_GENOME' {
        ext.args = [ "",
            "-t",
            "-k 50",
            "--best",
            "--strata",
            "-e 99999",
            "--chunkmbs 2048",
            params.bowtie_align_args ?: "",
        ].join(" ").trim()
    }


    //
    // MIRDEEP
    //

    withName: 'MIRDEEP2_MAPPER' {
        ext.args = "-c -j -m -v"
    }

    withName: 'SEQKIT_REPLACE' {
        ext.args = '-p "\\s+|\\." -w 0'
    }

    withName: 'MIRDEEP2_MIRDEEP2' {
        // -P: miRBase (v18+) mature IDs end in -5p/-3p. MirGeneDB uses _5p/_3p, which -P does not recognise.
        // -d: skip the per-miRNA structure PDFs (~0.3 MB each, one per reported or expressed known miRNA).
        //     Without -d they are published to mirdeep2/pdfs_<sample>/ and linked from the HTML report.
        ext.args      = { params.mirgenedb ? '-d' : '-P -d' }
        errorStrategy = { task.exitStatus == 255 ? 'ignore' : task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    }

    withName: '.*MIRDEEP2_CONSENSUS:GAWK_MIRDEEP2_SAMPLES' {
        ext.prefix = { "${meta.id}_samples" }
    }

    withName: '.*MIRDEEP2_CONSENSUS:BEDTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
    }

    withName: '.*MIRDEEP2_CONSENSUS:BEDTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_merged" }
        // -d -1: only merge loci that overlap by at least 1 bp, not book-ended ones
        ext.args   = '-s -d -1 -c 6,4,5,7,7,8 -o distinct,distinct,max,distinct,count_distinct,collapse'
    }

    //
    // reports
    //

    withName: 'MULTIQC' {
        ext.args   = params.multiqc_title ? "--title \"${params.multiqc_title}\"" : ""
    }
}
