nextflow_workflow {

    name "Test Workflow MIRDEEP2_CONSENSUS"
    script "../main.nf"
    workflow "MIRDEEP2_CONSENSUS"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/mirdeep2_consensus"
    tag "mirdeep2_consensus"

    // Small miRDeep2-like results (the BED files were made from the CSV files with miRDeep2's
    // mirdeep2bed.pl). Samples A, B and C share a novel locus on chr1 (+), with true-positive
    // probabilities 91, 75 and 88 %. A (95 %) and B (no probability, "-") share a known locus
    // on chr1 (-). B has a novel locus overlapping it on the opposite strand (60 %), A has a
    // novel locus on chr2 (40 %). D has an empty BED file and no CSV file.
    def input_channel = { base_dir -> """
        channel.of('A', 'B', 'C', 'D').map { id ->
            [ [ id: id, single_end: true ], files("${base_dir}/subworkflows/local/mirdeep2_consensus/tests/fixtures/result_\${id}.{bed,csv}") ]
        }
    """ }
    def header = ['#chrom', 'start', 'end', 'name', 'score', 'strand', 'n_samples', 'samples', 'probability', 'mirdeep2_ids'].join('\t')

    test("min_samples = 2, no probability filter") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 2
                input[2] = 0
                """
            }
        }

        then {
            def lines = path(workflow.out.bed.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines.size() == 3 },
                { assert lines[0] == header },
                { assert lines[1] == ['chr1', '100', '180', 'novel:consensus_1', '7.7', '+', '3', 'A,B,C', '91', 'A:novel:chr1_1,B:novel:chr1_2,C:novel:chr1_4'].join('\t') },
                { assert lines[2] == ['chr1', '1000', '1075', 'known:consensus_2', '10.1', '-', '2', 'A,B', '95', 'A:known:chr1_5,B:known:chr1_9'].join('\t') }
            )
        }
    }

    test("min_samples = 1, no probability filter") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 1
                input[2] = 0
                """
            }
        }

        then {
            def lines = path(workflow.out.bed.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines.size() == 5 },
                { assert lines.findAll { line -> line.startsWith('chr1\t1010\t1060\tnovel:') && line.endsWith('\t+\t1\tB\t60\tB:novel:chr1_7') }.size() == 1 },
                { assert lines.findAll { line -> line.startsWith('chr2\t500\t560\tnovel:') && line.endsWith('\t+\t1\tA\t40\tA:novel:chr2_3') }.size() == 1 }
            )
        }
    }

    test("min_samples above the number of samples") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 5
                input[2] = 0
                """
            }
        }

        then {
            def lines = path(workflow.out.bed.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines == [ header ] }
            )
        }
    }

    test("min_probability = 80 removes candidates before counting samples") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 2
                input[2] = 80
                """
            }
        }

        then {
            def lines = path(workflow.out.bed.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                // B's novel chr1 locus (75 %) is removed, so the locus is supported by A and C only
                // and no longer reaches B's end coordinate. B's known locus has no probability and is kept.
                { assert lines.size() == 3 },
                { assert lines[0] == header },
                { assert lines[1] == ['chr1', '100', '175', 'novel:consensus_1', '7.7', '+', '2', 'A,C', '91', 'A:novel:chr1_1,C:novel:chr1_4'].join('\t') },
                { assert lines[2] == ['chr1', '1000', '1075', 'known:consensus_2', '10.1', '-', '2', 'A,B', '95', 'A:known:chr1_5,B:known:chr1_9'].join('\t') }
            )
        }
    }

    test("min_probability = 99 keeps only entries without a probability") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 1
                input[2] = 99
                """
            }
        }

        then {
            def lines = path(workflow.out.bed.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines.size() == 2 },
                { assert lines[1] == ['chr1', '1000', '1075', 'known:consensus_1', '8', '-', '1', 'B', '-', 'B:known:chr1_9'].join('\t') }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 2
                input[2] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bed.size() == 1 },
                { assert file(workflow.out.bed.get(0).get(1)).name == 'mirdeep2_consensus.bed' }
            )
        }
    }
}
