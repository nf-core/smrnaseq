nextflow_workflow {

    name "Test Workflow MIRDEEP2_CONSENSUS"
    script "../main.nf"
    workflow "MIRDEEP2_CONSENSUS"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/mirdeep2_consensus"
    tag "mirdeep2_consensus"

    // Small miRDeep2-like results (the BED files were made from the CSV files with miRDeep2's
    // mirdeep2bed.pl). Samples A, B and C share a novel locus on chr1 (+), with true-positive
    // probabilities 91, 75 and 88 %. A (95 %) and B (no probability, "-") share a known locus
    // on chr1 (-). B has a novel locus overlapping it on the opposite strand (60 %), A has a
    // novel locus on chr2 (40 %). A (chr3:200-260, 85 %) and C (chr3:260-320, 90 %) have book-ended
    // novel loci on the same strand, which share no base. D has an empty BED file and no CSV file.
    // The chr3 rows were added by hand in the same format.
    def input_channel = { base_dir -> """
        channel.of('A', 'B', 'C', 'D').map { id ->
            [ [ id: id, single_end: true ], files("${base_dir}/subworkflows/local/mirdeep2_consensus/tests/fixtures/result_\${id}.{bed,csv}") ]
        }
    """ }
    // The BED file is plain BED6 without a header (score = number of samples), the TSV has the support columns
    def header = ['name', 'chrom', 'start', 'end', 'strand', 'n_samples', 'samples', 'score', 'probability', 'mirdeep2_ids'].join('\t')

    test("min_samples = 2, no probability filter") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 2
                input[2] = 0
                """
            }
        }

        then {
            def bed   = path(workflow.out.bed.get(0).get(1)).readLines()
            def lines = path(workflow.out.tsv.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines.size() == 3 },
                { assert lines[0] == header },
                { assert lines[1] == ['novel:consensus_1', 'chr1', '100', '180', '+', '3', 'A,B,C', '7.7', '91', 'A:novel:chr1_1,B:novel:chr1_2,C:novel:chr1_4'].join('\t') },
                // B's known entry has no probability ("-") and is kept without a filter
                { assert lines[2] == ['known:consensus_2', 'chr1', '1000', '1075', '-', '2', 'A,B', '10.1', '95', 'A:known:chr1_5,B:known:chr1_9'].join('\t') },
                // The book-ended chr3 loci of A and C are not merged, so neither reaches 2 samples
                { assert !lines.any { line -> line.contains('chr3') } },
                // Standard BED6: no header, six columns, integer score (number of samples)
                { assert bed == [
                    ['chr1', '100', '180', 'novel:consensus_1', '3', '+'].join('\t'),
                    ['chr1', '1000', '1075', 'known:consensus_2', '2', '-'].join('\t')
                ] }
            )
        }
    }

    test("min_samples = 1, no probability filter") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 1
                input[2] = 0
                """
            }
        }

        then {
            def bed   = path(workflow.out.bed.get(0).get(1)).readLines()
            def lines = path(workflow.out.tsv.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines.size() == 7 },
                { assert lines[0] == header },
                { assert lines.count { line -> line ==~ /novel:consensus_\d+\tchr1\t1010\t1060\t\+\t1\tB\t2\t60\tB:novel:chr1_7/ } == 1 },
                { assert lines.count { line -> line ==~ /novel:consensus_\d+\tchr2\t500\t560\t\+\t1\tA\t1\.1\t40\tA:novel:chr2_3/ } == 1 },
                // Book-ended loci (A ends at 260, C starts at 260) stay separate
                { assert lines.count { line -> line ==~ /novel:consensus_\d+\tchr3\t200\t260\t\+\t1\tA\t4\t85\tA:novel:chr3_6/ } == 1 },
                { assert lines.count { line -> line ==~ /novel:consensus_\d+\tchr3\t260\t320\t\+\t1\tC\t3\t90\tC:novel:chr3_8/ } == 1 },
                { assert bed.size() == 6 },
                { assert bed.every { line -> line ==~ /chr\d\t\d+\t\d+\t(known|novel):consensus_\d+\t\d+\t[+-]/ } },
                // Each BED line is the TSV row of the same name
                { assert bed == lines.drop(1).collect { line -> def f = line.split('\t'); [f[1], f[2], f[3], f[0], f[5], f[4]].join('\t') } },
                { assert bed.count { line -> line ==~ /chr3\t200\t260\tnovel:consensus_\d+\t1\t\+/ } == 1 },
                { assert bed.count { line -> line ==~ /chr3\t260\t320\tnovel:consensus_\d+\t1\t\+/ } == 1 }
            )
        }
    }

    test("min_samples above the number of samples") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 5
                input[2] = 0
                """
            }
        }

        then {
            def bed   = path(workflow.out.bed.get(0).get(1)).readLines()
            def lines = path(workflow.out.tsv.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines == [ header ] },
                { assert bed.isEmpty() }
            )
        }
    }

    test("min_probability = 80 removes candidates before counting samples") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 2
                input[2] = 80
                """
            }
        }

        then {
            def bed   = path(workflow.out.bed.get(0).get(1)).readLines()
            def lines = path(workflow.out.tsv.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                // B's novel chr1 locus (75 %) is removed, so the locus is supported by A and C only
                // and no longer reaches B's end coordinate. B's known entry has no probability and is
                // removed, so the known locus is only found in A and does not reach min_samples.
                { assert lines.size() == 2 },
                { assert lines[0] == header },
                { assert lines[1] == ['novel:consensus_1', 'chr1', '100', '175', '+', '2', 'A,C', '7.7', '91', 'A:novel:chr1_1,C:novel:chr1_4'].join('\t') },
                { assert bed == [ ['chr1', '100', '175', 'novel:consensus_1', '2', '+'].join('\t') ] }
            )
        }
    }

    test("min_probability = 1 removes only entries without a probability") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 1
                input[2] = 1
                """
            }
        }

        then {
            def bed   = path(workflow.out.bed.get(0).get(1)).readLines()
            def lines = path(workflow.out.tsv.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines.size() == 7 },
                { assert bed.size() == 6 },
                { assert !lines.any { line -> line.contains('B:known:chr1_9') } },
                { assert lines.count { line -> line ==~ /known:consensus_\d+\tchr1\t1000\t1075\t-\t1\tA\t10\.1\t95\tA:known:chr1_5/ } == 1 }
            )
        }
    }

    test("min_probability = 99 removes all entries") {

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 1
                input[2] = 99
                """
            }
        }

        then {
            def bed   = path(workflow.out.bed.get(0).get(1)).readLines()
            def lines = path(workflow.out.tsv.get(0).get(1)).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines == [ header ] },
                { assert bed.isEmpty() }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = ${input_channel(baseDir)}
                input[1] = 2
                input[2] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bed.size() == 1 },
                { assert file(workflow.out.bed.get(0).get(1)).name == 'mirdeep2_consensus.bed' },
                { assert workflow.out.tsv.size() == 1 },
                { assert file(workflow.out.tsv.get(0).get(1)).name == 'mirdeep2_consensus.tsv' }
            )
        }
    }
}
