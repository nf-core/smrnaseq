process {
    withName: 'CONTAMINANT_FILTER:BLAT.*' {
        ext.args = '-out=blast8'
        ext.prefix = {"${meta.id}_${meta2.id}"}
        tag = {"${meta.id} ${meta2.id}"}
    }

    withName: 'CONTAMINANT_FILTER:GAWK.*' {
        ext.prefix = {"significant_hits_${meta.id}"}
    }

    withName: 'CONTAMINANT_FILTER:SEQKIT_GREP.*' {
        ext.prefix = {"filtered_${meta.id}"}
        ext.args = '-v'
    }

    withName: 'CONTAMINANT_FILTER:BOWTIE2_ALIGN.*' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
    }

    withName: 'CONTAMINANT_FILTER:STATS_GAWK_CDNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.suffix = "stats"
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "cDNA" + '\\": " tot}\''
    }

    withName: 'CONTAMINANT_FILTER:STATS_GAWK_NCRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.suffix = "stats"
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "ncRNA" + '\\": " tot}\''
    }

    withName: 'CONTAMINANT_FILTER:STATS_GAWK_PIRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.suffix = "stats"
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "piRNA" + '\\": " tot}\''
    }

    withName: 'CONTAMINANT_FILTER:STATS_GAWK_OTHER' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.suffix = "stats"
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "other" + '\\": " tot}\''
    }

    withName: 'CONTAMINANT_FILTER:STATS_GAWK_TRNA' {
        ext.prefix = {"${meta.contaminant}_${meta.id}"}
        ext.suffix = "stats"
        ext.args2 = '\'BEGIN {tot=0} {if(\$0 ~ /aligned exactly 1 time|aligned >1 times/){tot+=\$1}} END {print "\\"' + "tRNA" + '\\": " tot}\''
    }
}
