nextflow_function {

    name "Test Functions"
    script "../main.nf"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_smrnaseq_pipeline"
    tag "subworkflows/utils_nfcore_smrnaseq_pipeline"

    test("Test Function mirtraceConfigLine - adapter sequence") {

        function "mirtraceConfigLine"

        when {
            function {
                """
                input[0] = 'sample1.fastq.gz'
                input[1] = 'sample1'
                input[2] = 'TGGAATTCTCGGGTGCCAAGG'
                input[3] = '33'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == "./sample1.fastq.gz,sample1,TGGAATTCTCGGGTGCCAAGG,33\n" }
            )
        }
    }

    test("Test Function mirtraceConfigLine - auto-detect") {

        function "mirtraceConfigLine"

        when {
            function {
                """
                input[0] = 'sample1.fastq.gz'
                input[1] = 'sample1'
                input[2] = 'auto-detect'
                input[3] = '33'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // miRTrace cannot auto-detect adapters: an empty adapter field means no adapter trimming
                { assert function.result == "./sample1.fastq.gz,sample1,,33\n" }
            )
        }
    }

    test("Test Function mirtraceAdapterWarning - adapter sequence") {

        function "mirtraceAdapterWarning"

        when {
            function {
                """
                input[0] = 'TGGAATTCTCGGGTGCCAAGG'
                input[1] = 'hsa'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function mirtraceAdapterWarning - auto-detect") {

        function "mirtraceAdapterWarning"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = 'hsa'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("miRTrace cannot auto-detect adapters") }
            )
        }
    }

    test("Test Function mirtraceAdapterWarning - auto-detect without miRTrace species") {

        function "mirtraceAdapterWarning"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = null
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // miRTrace does not run without a species, so there is nothing to warn about
                { assert function.result == null }
            )
        }
    }

    // umiParameterError inputs: with_umi, bc_pattern

    test("Test Function umiParameterError - without UMI") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = false
                input[1] = null
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiParameterError - QIAseq pattern") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = true
                input[1] = '.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiParameterError - missing pattern") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = true
                input[1] = null
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("'--with_umi' requires '--umitools_bc_pattern'") }
            )
        }
    }

    // umiDeprecationWarnings inputs: skip_umi_extract_before_dedup, umi_discard_read

    test("Test Function umiDeprecationWarnings - not set") {

        function "umiDeprecationWarnings"

        when {
            function {
                """
                input[0] = null
                input[1] = null
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [] }
            )
        }
    }

    test("Test Function umiDeprecationWarnings - both set") {

        function "umiDeprecationWarnings"

        when {
            function {
                """
                input[0] = true
                input[1] = 0
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.size() == 2 },
                { assert function.result[0].contains("'--skip_umi_extract_before_dedup' is deprecated and ignored") },
                { assert function.result[1].contains("'--umi_discard_read' is deprecated and ignored") }
            )
        }
    }

    // umiSaturationWarning input: the UMI_FROM_SEQUENCE statistics TSV as text

    test("Test Function umiSaturationWarning - saturated") {

        function "umiSaturationWarning"

        when {
            function {
                """
                input[0] = 'sample\\tumi_length\\treads\\tdistinct_sequences\\ttop_sequence\\ttop_sequence_reads\\tumi_space\\ttop_sequence_umi_fraction\\n' +
                    'S1\\t12\\t575696\\t120000\\tTAGCAGCACGTAAATATTGGCG\\t180000\\t16777216\\t0.010729\\n'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("UMI saturation in sample 'S1'") },
                { assert function.result.contains("(TAGCAGCACGTAAATATTGGCG) has 180000 reads, 1.07% of all 16777216 possible 12 nt UMIs") }
            )
        }
    }

    test("Test Function umiSaturationWarning - below threshold") {

        function "umiSaturationWarning"

        when {
            function {
                """
                input[0] = 'sample\\tumi_length\\treads\\tdistinct_sequences\\ttop_sequence\\ttop_sequence_reads\\tumi_space\\ttop_sequence_umi_fraction\\n' +
                    'S1\\t12\\t100000\\t20000\\tTAGCAGCACGTAAATATTGGCG\\t80000\\t16777216\\t0.004768\\n'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiSaturationWarning - stub output without data") {

        function "umiSaturationWarning"

        when {
            function {
                """
                input[0] = 'sample\\tumi_length\\treads\\tdistinct_sequences\\ttop_sequence\\ttop_sequence_reads\\tumi_space\\ttop_sequence_umi_fraction\\n'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }
}
