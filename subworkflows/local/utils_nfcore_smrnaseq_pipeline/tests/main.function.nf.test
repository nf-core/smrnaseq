nextflow_function {

    name "Test Functions"
    script "../main.nf"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_smrnaseq_pipeline"
    tag "subworkflows/utils_nfcore_smrnaseq_pipeline"

    test("Test Function mirtraceConfigLine - adapter sequence") {

        function "mirtraceConfigLine"

        when {
            function {
                """
                input[0] = 'sample1.fastq.gz'
                input[1] = 'sample1'
                input[2] = 'TGGAATTCTCGGGTGCCAAGG'
                input[3] = '33'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == "./sample1.fastq.gz,sample1,TGGAATTCTCGGGTGCCAAGG,33\n" }
            )
        }
    }

    test("Test Function mirtraceConfigLine - auto-detect") {

        function "mirtraceConfigLine"

        when {
            function {
                """
                input[0] = 'sample1.fastq.gz'
                input[1] = 'sample1'
                input[2] = 'auto-detect'
                input[3] = '33'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // miRTrace cannot auto-detect adapters: an empty adapter field means no adapter trimming
                { assert function.result == "./sample1.fastq.gz,sample1,,33\n" }
            )
        }
    }

    test("Test Function mirtraceAdapterWarning - adapter sequence") {

        function "mirtraceAdapterWarning"

        when {
            function {
                """
                input[0] = 'TGGAATTCTCGGGTGCCAAGG'
                input[1] = 'hsa'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function mirtraceAdapterWarning - auto-detect") {

        function "mirtraceAdapterWarning"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = 'hsa'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("miRTrace cannot auto-detect adapters") }
            )
        }
    }

    test("Test Function mirtraceAdapterWarning - auto-detect without miRTrace species") {

        function "mirtraceAdapterWarning"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = null
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // miRTrace does not run without a species, so there is nothing to warn about
                { assert function.result == null }
            )
        }
    }

    // umiParameterError inputs: with_umi, bc_pattern, skip_umi_extract_before_dedup

    test("Test Function umiParameterError - without UMI") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = false
                input[1] = null
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiParameterError - valid") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = true
                input[1] = '.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiParameterError - missing pattern") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = true
                input[1] = null
                input[2] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("'--with_umi' requires '--umitools_bc_pattern'") }
            )
        }
    }

    test("Test Function umiParameterError - extraction before deduplication") {

        function "umiParameterError"

        when {
            function {
                """
                input[0] = true
                input[1] = 'NNNNNNNN'
                input[2] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("'--skip_umi_extract_before_dedup false' is not supported") }
            )
        }
    }

    // umiAdapterWarning inputs: with_umi, bc_pattern, three_prime_adapter, skip_fastp, trim_fastq

    test("Test Function umiAdapterWarning - QIAseq pattern with TruSeq adapter") {

        function "umiAdapterWarning"

        when {
            function {
                """
                input[0] = true
                input[1] = '.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'
                input[2] = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'
                input[3] = false
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiAdapterWarning - pattern anchored on the trimmed adapter") {

        function "umiAdapterWarning"

        when {
            function {
                """
                input[0] = true
                input[1] = '.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'
                input[2] = 'AACTGTAGGCACCATCAAT'
                input[3] = false
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.contains("contains the 3' adapter given in '--three_prime_adapter' (AACTGTAGGCACCATCAAT)") }
            )
        }
    }

    test("Test Function umiAdapterWarning - pattern anchored on the adapter with --skip_fastp") {

        function "umiAdapterWarning"

        when {
            function {
                """
                input[0] = true
                input[1] = '.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'
                input[2] = 'AACTGTAGGCACCATCAAT'
                input[3] = true
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // fastp does not trim the adapter, so the pattern still finds it
                { assert function.result == null }
            )
        }
    }

    test("Test Function umiAdapterWarning - without UMI") {

        function "umiAdapterWarning"

        when {
            function {
                """
                input[0] = false
                input[1] = null
                input[2] = 'AACTGTAGGCACCATCAAT'
                input[3] = false
                input[4] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }
}
