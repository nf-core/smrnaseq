nextflow_function {

    name "Test Functions"
    script "../main.nf"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_smrnaseq_pipeline"
    tag "subworkflows/utils_nfcore_smrnaseq_pipeline"

    test("Test Function mirtraceConfigLine - adapter sequence") {

        function "mirtraceConfigLine"

        when {
            function {
                """
                input[0] = 'sample1.fastq.gz'
                input[1] = 'sample1'
                input[2] = 'TGGAATTCTCGGGTGCCAAGG'
                input[3] = '33'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == "./sample1.fastq.gz,sample1,TGGAATTCTCGGGTGCCAAGG,33\n" }
            )
        }
    }

    test("Test Function mirtraceConfigLine - auto-detect") {

        function "mirtraceConfigLine"

        when {
            function {
                """
                input[0] = 'sample1.fastq.gz'
                input[1] = 'sample1'
                input[2] = 'auto-detect'
                input[3] = '33'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // miRTrace cannot auto-detect adapters: an empty adapter field means no adapter trimming
                { assert function.result == "./sample1.fastq.gz,sample1,,33\n" }
            )
        }
    }

    test("Test Function mirtraceAdapter - auto-detect, adapter detected by fastp") {

        function "mirtraceAdapter"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = 'AACTGTAGGCACCATCAAT'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'AACTGTAGGCACCATCAAT' }
            )
        }
    }

    test("Test Function mirtraceAdapter - auto-detect, fastp reports unspecified") {

        function "mirtraceAdapter"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = 'unspecified'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // fallback: mirtraceConfigLine() writes an empty adapter field for 'auto-detect'
                { assert function.result == 'auto-detect' }
            )
        }
    }

    test("Test Function mirtraceAdapter - auto-detect, no fastp adapter") {

        function "mirtraceAdapter"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = null
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // fastp skipped, or the adapter is missing from its JSON
                { assert function.result == 'auto-detect' }
            )
        }
    }

    test("Test Function mirtraceAdapter - auto-detect, empty fastp adapter") {

        function "mirtraceAdapter"

        when {
            function {
                """
                input[0] = 'auto-detect'
                input[1] = ''
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'auto-detect' }
            )
        }
    }

    test("Test Function mirtraceAdapter - explicit adapter") {

        function "mirtraceAdapter"

        when {
            function {
                """
                input[0] = 'TGGAATTCTCGGGTGCCAAGG'
                input[1] = 'AACTGTAGGCACCATCAAT'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // explicit adapters are never replaced by the fastp adapter
                { assert function.result == 'TGGAATTCTCGGGTGCCAAGG' }
            )
        }
    }
}
