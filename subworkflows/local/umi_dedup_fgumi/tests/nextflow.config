process {
    withName: 'UMITOOLS_EXTRACT' {
        ext.args = "--extract-method=regex --bc-pattern='.+(?P<discard_1>AACTGTAGGCACCATCAAT){s<=2}(?P<umi_1>.{12})(?P<discard_2>.*)'"
    }
    withName: 'UMI_DEDUP_FGUMI:BOWTIE_MAP_UMI_DEDUP' {
        // fgumi needs exactly one primary record per read: bowtie1 -k >1 writes every hit as primary
        ext.args   = '-t -k 1 --best -e 99999 --chunkmbs 2048'
        ext.prefix = { "${meta.id}.umi_dedup" }
    }
    withName: 'UMI_DEDUP_FGUMI:FGUMI_SORT' {
        ext.args = '--order template-coordinate'
    }
    withName: 'UMI_DEDUP_FGUMI:FGUMI_DEDUP' {
        // reads that do not align to the dedup reference are passed through (not deduplicated)
        ext.args = '--strategy adjacency --edits 1 --remove-duplicates --include-unmapped'
    }
    withName: 'UMI_DEDUP_FGUMI:FGUMI_FASTQ' {
        ext.prefix = { "${meta.id}.umi_dedup" }
    }
}
