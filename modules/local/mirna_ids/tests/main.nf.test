nextflow_process {

    name "Test Process MIRNA_IDS"
    script "../main.nf"
    process "MIRNA_IDS"
    tag "modules"
    tag "modules_local"
    tag "mirna_ids"

    test("miRBase GFF3") {

        when {
            process {
                """
                input[0] = [[id:'hsa', species:'hsa'], file(params.pipelines_testdata_base_path + 'reference/hsa.gff3', checkIfExists: true)]
                input[1] = [[id:'mature'], file(params.pipelines_testdata_base_path + 'reference/mature.fa', checkIfExists: true)]
                input[2] = [[id:'hairpin'], file(params.pipelines_testdata_base_path + 'reference/hairpin.fa', checkIfExists: true)]
                input[3] = 'hsa'
                input[4] = 'miRBase'
                """
            }
        }

        then {
            def rows = path(process.out.mirna_ids[0]).readLines()*.split('\t', -1)
            def by_name = rows.drop(1).collectEntries { row -> [("${row[2]}:${row[0]}".toString()): row] }
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert rows[0] == ['name', 'accession', 'type', 'precursor', 'precursor_accession', 'database'] },
                // Mature names map to MIMAT accessions and to all their precursors, in matching order
                { assert by_name['mature:hsa-let-7a-5p'] == ['hsa-let-7a-5p', 'MIMAT0000062', 'mature', 'hsa-let-7a-1,hsa-let-7a-2,hsa-let-7a-3', 'MI0000060,MI0000061,MI0000062', 'miRBase'] },
                { assert by_name['mature:hsa-miR-1-3p'] == ['hsa-miR-1-3p', 'MIMAT0000416', 'mature', 'hsa-mir-1-1,hsa-mir-1-2', 'MI0000651,MI0000437', 'miRBase'] },
                { assert by_name['hairpin:hsa-let-7a-1'] == ['hsa-let-7a-1', 'MI0000060', 'hairpin', '', '', 'miRBase'] },
                // FASTA names that are not in the GFF (older release) are kept, without accession
                { assert by_name['mature:hsa-miR-375'][1] == '' },
                // Only the requested species, one row per name and type
                { assert rows.drop(1).every { row -> row[0].startsWith('hsa-') } },
                { assert by_name.size() == rows.size() - 1 }
            )
        }
    }

    test("MirGeneDB GFF") {

        when {
            process {
                """
                input[0] = [[id:'mirgenedb_hsa', species:'Hsa'], file(params.pipelines_testdata_base_path + 'MirGeneDB/mirgenedb_hsa.gff', checkIfExists: true)]
                input[1] = [[id:'mature'], file(params.pipelines_testdata_base_path + 'MirGeneDB/mirgenedb_hsa_mature.fa', checkIfExists: true)]
                input[2] = [[id:'hairpin'], file(params.pipelines_testdata_base_path + 'MirGeneDB/mirgenedb_hsa_hairpin.fa', checkIfExists: true)]
                input[3] = 'Hsa'
                input[4] = 'MirGeneDB'
                """
            }
        }

        then {
            def rows = path(process.out.mirna_ids[0]).readLines()*.split('\t', -1)
            def by_name = rows.drop(1).collectEntries { row -> [("${row[2]}:${row[0]}".toString()): row] }
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Names are the MirGeneDB IDs; star arms keep their `*`; precursors come from coordinates
                { assert by_name['mature:Hsa-Mir-3613_5p'] == ['Hsa-Mir-3613_5p', 'MIMAT0017990', 'mature', 'Hsa-Mir-3613_pre', 'MI0016003', 'MirGeneDB'] },
                { assert by_name['mature:Hsa-Mir-3613_3p*'] == ['Hsa-Mir-3613_3p*', 'MIMAT0017991', 'mature', 'Hsa-Mir-3613_pre', 'MI0016003', 'MirGeneDB'] },
                { assert by_name['hairpin:Hsa-Mir-3613_pre'] == ['Hsa-Mir-3613_pre', 'MI0016003', 'hairpin', '', '', 'MirGeneDB'] },
                // MirGeneDB-only miRNAs have no miRBase accession, but still a precursor
                { assert rows.drop(1).any { row -> row[2] == 'mature' && row[1] == '' && row[3] != '' } },
                { assert rows.drop(1).every { row -> row[2] == 'hairpin' || row[3] != '' } },
                { assert by_name.size() == rows.size() - 1 }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [[id:'hsa', species:'hsa'], file(params.pipelines_testdata_base_path + 'reference/hsa.gff3', checkIfExists: true)]
                input[1] = [[id:'mature'], file(params.pipelines_testdata_base_path + 'reference/mature.fa', checkIfExists: true)]
                input[2] = [[id:'hairpin'], file(params.pipelines_testdata_base_path + 'reference/hairpin.fa', checkIfExists: true)]
                input[3] = 'hsa'
                input[4] = 'miRBase'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
