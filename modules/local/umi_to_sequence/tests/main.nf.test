nextflow_process {

    name "Test Process UMI_TO_SEQUENCE"
    script "../main.nf"
    process "UMI_TO_SEQUENCE"
    tag "modules"
    tag "modules_local"
    tag "umi_to_sequence"

    test("umi_tools extract reads - UMI moved into sequence and quality") {

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ], file("${moduleDir}/tests/fixtures/extracted.fastq.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            def lines = path(process.out.reads.get(0).get(1)).linesGzip
            assertAll(
                { assert process.success },
                { assert lines.size() == 20 },
                // Read names are unchanged
                { assert lines[0] == '@SRR11631013.5_ATCTGCTCTCCG 5 length=85' },
                // UMI prepended to the sequence, 'I' qualities prepended to the quality string
                { assert lines[1] == 'ATCTGCTCTCCG' + 'TAGCAGCACGTAAATATTGGCG' },
                { assert lines[2] == '+' },
                { assert lines[3] == 'IIIIIIIIIIII' + 'AAAAAEEEEEEEEEEEEEE#EE' },
                // The UMI is the last '_'-separated field of the read name, even if the name has other underscores
                { assert lines[12] == '@sample_A.28_TGGCACACTCCG 28 length=85' },
                { assert lines[13] == 'TGGCACACTCCG' + 'TAGCAGCACGTAAATATTGGCG' },
                { assert lines[15] == 'IIIIIIIIIIII' + 'A6/AA/AEEEE/E6EEEEA/EE' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("umi_tools extract reads - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test', single_end:true ], file("${moduleDir}/tests/fixtures/extracted.fastq.gz", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
