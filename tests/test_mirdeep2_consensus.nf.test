nextflow_pipeline {

    name "Test pipeline with --mirdeep2_consensus_min_samples"
    script "../main.nf"
    profile "test_mirgenedb,ci"
    tag "pipeline"
    tag "mirdeep2_consensus"

    // miRDeep2 reports one known miRNA per test sample, at two different hairpins. Its estimated
    // true-positive probability is "0 +/- 0%" in Clone1_N1 and "-" (no estimate, as miRDeep2 found
    // no novel candidates) in Control_N1.
    // mirdeep2_consensus.bed is plain BED6 without a header (score = number of samples),
    // mirdeep2_consensus.tsv has one row per locus with its support.
    def header = ['name', 'chrom', 'start', 'end', 'strand', 'n_samples', 'samples', 'score', 'probability', 'mirdeep2_ids'].join('\t')

    test("-profile test_mirgenedb --mirdeep2_consensus_min_samples 1") {

        when {
            params {
                outdir = "$outputDir"
                mirdeep2_consensus_min_samples = 1
            }
        }

        then {
            def consensus = new File("${outputDir}/mirdeep2/mirdeep2_consensus.bed")
            def support   = new File("${outputDir}/mirdeep2/mirdeep2_consensus.tsv")
            def bed   = consensus.exists() ? consensus.readLines() : []
            def lines = support.exists() ? support.readLines() : []
            assertAll(
                { assert workflow.success },
                { assert new File("${outputDir}/mirdeep2/result_Clone1_N1.bed").exists() },
                { assert consensus.exists() },
                { assert support.exists() },
                { assert bed == [
                    ['hg38_dna', '1259227', '1259294', 'known:consensus_1', '1', '+'].join('\t'),
                    ['hg38_dna', '1259964', '1260039', 'known:consensus_2', '1', '+'].join('\t')
                ] },
                { assert lines.size() == 3 },
                { assert lines[0] == header },
                { assert lines[1] == ['known:consensus_1', 'hg38_dna', '1259227', '1259294', '+', '1', 'Control_N1', '2.4', '-', 'Control_N1:known:hg38_dna_6'].join('\t') },
                { assert lines[2] == ['known:consensus_2', 'hg38_dna', '1259964', '1260039', '+', '1', 'Clone1_N1', '1.4', '0', 'Clone1_N1:known:hg38_dna_6'].join('\t') }
            )
        }
    }

    test("-profile test_mirgenedb --mirdeep2_consensus_min_samples 1 --mirdeep2_consensus_min_probability 1") {

        when {
            params {
                outdir = "$outputDir"
                mirdeep2_consensus_min_samples = 1
                mirdeep2_consensus_min_probability = 1
            }
        }

        then {
            def consensus = new File("${outputDir}/mirdeep2/mirdeep2_consensus.bed")
            def support   = new File("${outputDir}/mirdeep2/mirdeep2_consensus.tsv")
            assertAll(
                { assert workflow.success },
                // Clone1_N1 (0 %) and Control_N1 (no probability) are both removed:
                // empty BED file, TSV with the header only
                { assert consensus.exists() },
                { assert consensus.readLines().isEmpty() },
                { assert support.exists() },
                { assert support.readLines() == [ header ] }
            )
        }
    }
}
