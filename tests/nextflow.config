/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/smrnaseq/'
}

// `modules_testdata_base_path` is only read by the nf-core module tests, so it is not a pipeline
// parameter. Tell nf-schema to ignore it instead of warning about an invalid input value.
validation.ignoreParams = ['modules_testdata_base_path']

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
