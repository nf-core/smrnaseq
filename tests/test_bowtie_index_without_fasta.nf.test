nextflow_pipeline {

    name "Test pipeline with --bowtie_index but no genome FASTA"
    script "../main.nf"
    profile "test,ci"
    tag "pipeline"
    tag "bowtie_index_without_fasta"

    // `-profile test` sets both `fasta` and `bowtie_index`. Unsetting `fasta` leaves only the
    // genome Bowtie index, which is ignored: the run warns and skips GENOME_QUANT and miRDeep2.
    // `-stub` keeps this cheap, as only the parameter handling and channel wiring are tested.
    test("-profile test --bowtie_index without --fasta -stub") {

        options "-stub"

        when {
            params {
                outdir       = "$outputDir"
                fasta        = null
                skip_mirdeep = false
            }
        }

        then {
            def warning = "A genome Bowtie index was given with '--bowtie_index', but no genome FASTA"
            def log_text = new File("${launchDir}/meta/nextflow.log").text
            assertAll(
                { assert workflow.success },
                // log.warn always goes to .nextflow.log; the console only shows it outside agent log mode
                { assert log_text.contains(warning) },
                { assert !workflow.trace.tasks().any { task -> task.name.contains('GENOME_QUANT') || task.name.contains('MIRDEEP2') } },
                { assert !new File("${outputDir}/genome_quant").exists() },
                { assert !new File("${outputDir}/mirdeep2").exists() }
            )
        }
    }

    test("-profile test --bowtie_index with --fasta -stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def warning = "A genome Bowtie index was given with '--bowtie_index', but no genome FASTA"
            def log_text = new File("${launchDir}/meta/nextflow.log").text
            assertAll(
                { assert workflow.success },
                { assert !log_text.contains(warning) },
                { assert workflow.trace.tasks().any { task -> task.name.contains('GENOME_QUANT:BOWTIE_MAP_GENOME') } }
            )
        }
    }
}
